{
  "version": 2,
  "builds": [
    {
      "src": "api/dashboard-server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/dashboard-server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ],
  "functions": {
    "api/dashboard-server.js": {
      "maxDuration": 30
    }
  }
}